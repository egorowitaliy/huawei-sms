[huawei-sms]
user = www-data
group = www-data

listen = /run/php/huawei-sms.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = dynamic
pm.max_children = 5
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3

clear_env = yes
catch_workers_output = yes
security.limit_extensions = .php
